@prefix ds-tcat: <https://w3id.org/dataspaces/ont/ds-tcat/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix schema:  <https://schema.org/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix voaf:    <http://purl.org/vocommons/voaf#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix bibo:    <http://purl.org/ontology/bibo/> .
@prefix lang:    <http://publications.europa.eu/resource/authority/language/> .
@prefix adms:    <http://www.w3.org/ns/adms#> .
@prefix dssc:    <https://w3id.org/dataspaces/ont/dssc/> .
@prefix tcat:    <https://w3id.org/dataspaces/ont/tcat/> .

# Ontology Definition
ds-tcat:
    a                             owl:Ontology, voaf:Vocabulary ;

    # Basic Metadata
    dcterms:title                 "Dataspaces Tool Catalog Ontology (DS TCAT)"@en ;
    dcterms:description           "An ontology for describing metadata about dataspaces tools and services in catalogs or toolboxes, supporting discovery, comparison, and interoperability. These tools represent implementations of Dataspace Services as defined in the DSSC Dataspaces Blueprint v2.0."@en ;

    # Version Information
    owl:versionInfo               "0.3.0"^^xsd:string ;
    dcterms:hasVersion            "0.3.0"^^xsd:string ;
    owl:versionIRI                <https://w3id.org/dataspaces/ont/ds-tcat/0.3.0> ;
    #owl:priorVersion              <https://w3id.org/dataspaces/ont/ds-tcat/0.0.0> ;

    # Timeline
    dcterms:created               "2025-08-25"^^xsd:date ;
    dcterms:modified              "2025-08-25"^^xsd:date ;
    #dcterms:issued                "<to be added>"^^xsd:date ;
    #bibo:doi                      "<to be added>" ;

    # Creators and Contributors
    dcterms:creator               <https://orcid.org/0000-0003-2885-7076> ;
    #dcterms:creator               <to be added> ;
    #dcterms:contributor           <to be added> ;

    # Publisher Information
    #dcterms:publisher              "<to be added>" ;

    # License and Rights
    dcterms:license               <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights                "This ontology is distributed under the Creative Commons Attribution 4.0 International License."@en ;

    # Namespace Information
    vann:preferredNamespacePrefix "ds-tcat" ;
    vann:preferredNamespaceUri    "https://w3id.org/dataspaces/ont/ds-tcat/"^^xsd:anyURI ;

    # See Also
    rdfs:seeAlso                  <https://github.com/Fraunhofer-FIT-DSAI/ds-tcat-ap> ;
    vann:example                  <https://github.com/Fraunhofer-FIT-DSAI/ds-tcat-ap/tree/main/examples> ;

    # Additional Metadata
    dcterms:language              lang:ENG ;
    dcterms:subject               "Dataspaces tool catalog"@en, "Dataspaces toolbox"@en, "Dataspaces tool metadata"@en ;
    dcterms:audience              "Dataspaces toolbox maintainers"@en, "Dataspaces tool providers"@en,
                                  "Dataspaces tool consumers"@en ;
    dcterms:coverage              "Global"@en .

ds-tcat:DataspaceToolCatalog
    a                owl:Class, rdfs:Class ;
    rdfs:label       "Dataspace Tool Catalog"@en ;
    rdfs:comment     "A catalog of software tools for dataspace ecosystems; specialization of the generic Software Tool Catalog."@en ;
    rdfs:subClassOf  tcat:SoftwareToolCatalog ;
    rdfs:isDefinedBy ds-tcat: .

ds-tcat:correspondingDataspacesBlueprintVersion
    a                owl:DatatypeProperty, rdf:Property ;
    rdfs:label       "corresponding Dataspaces Blueprint version"@en ;
    rdfs:comment     "Version(s) of the DSSC Dataspaces Blueprint that the catalog corresponds to."@en ;
    rdfs:range       xsd:string ;
    rdfs:isDefinedBy ds-tcat: .

ds-tcat:dataspaceSpecificPurpose
    a                owl:DatatypeProperty, rdf:Property ;
    rdfs:label       "dataspace-specific purpose"@en ;
    rdfs:comment     "Purpose statement describing the catalog’s specific intent within dataspace contexts."@en ;
    rdfs:range       xsd:string ;
    rdfs:isDefinedBy ds-tcat: .

ds-tcat:DataspaceTool
    a                owl:Class, rdfs:Class ;
    rdfs:label       "Dataspace Tool"@en ;
    rdfs:comment     "A software tool in the dataspace context; specialization of the generic TCAT Software Tool."@en ;
    rdfs:subClassOf  tcat:SoftwareTool ;
    rdfs:isDefinedBy ds-tcat: .

ds-tcat:implementsDataspaceComponent
    a                owl:ObjectProperty, rdf:Property ;
    rdfs:label       "implements dataspace component"@en ;
    rdfs:comment     "Links a dataspace tool to the DSSC dataspace component it implements."@en ;
    rdfs:domain      ds-tcat:DataspaceTool ;
    rdfs:range       dssc:DataspaceComponent ;
    rdfs:isDefinedBy ds-tcat: .

#########################################################################
### Reused terms (minimal mentions with origin via rdfs:isDefinedBy) ###
#########################################################################

################################# Reused classes #################################

dcterms:LicenseDocument
    a                rdfs:Class ;
    rdfs:isDefinedBy dcterms: .

dcterms:RightsStatement
    a                rdfs:Class ;
    rdfs:isDefinedBy dcterms: .

dcterms:LinguisticSystem
    a                rdfs:Class ;
    rdfs:isDefinedBy dcterms: .

rdfs:Resource
    a                rdfs:Class ;
    rdfs:isDefinedBy rdfs: .

################################# Reused properties #################################

dcat:contactPoint
    a                rdf:Property ;
    rdfs:isDefinedBy dcat: .

dcat:version
    a                rdf:Property ;
    rdfs:isDefinedBy dcat: .

dcat:record
    a                rdf:Property ;
    rdfs:isDefinedBy dcat: .

adms:versionNotes
    a                rdf:Property ;
    rdfs:isDefinedBy adms: .

dcat:keyword
    a                rdf:Property ;
    rdfs:isDefinedBy dcat: .

dcterms:language
    a                rdf:Property ;
    rdfs:isDefinedBy dcterms: .

dcat:landingPage
    a                rdf:Property ;
    rdfs:isDefinedBy dcat: .

dcat:themeTaxonomy
    a                rdf:Property ;
    rdfs:isDefinedBy dcat: .

dcat:theme
    a                rdf:Property ;
    rdfs:isDefinedBy dcat: .

dcterms:rights
    a                rdf:Property ;
    rdfs:isDefinedBy dcterms: .

dcterms:isReferencedBy
    a                rdf:Property ;
    rdfs:isDefinedBy dcterms: .

dcterms:license
    a                rdf:Property ;
    rdfs:isDefinedBy dcterms: .

dcterms:accessRights
    a                rdf:Property ;
    rdfs:isDefinedBy dcterms: .