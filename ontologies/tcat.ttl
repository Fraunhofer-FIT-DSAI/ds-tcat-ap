@prefix tcat:    <https://w3id.org/dataspaces/ont/tcat/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix schema:  <https://schema.org/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix voaf:    <http://purl.org/vocommons/voaf#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix bibo:    <http://purl.org/ontology/bibo/> .
@prefix lang:    <http://publications.europa.eu/resource/authority/language/> .
@prefix vcard:   <http://www.w3.org/2006/vcard/ns#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix adms:    <http://www.w3.org/ns/adms#> .

# Ontology Definition
tcat:
    a                             owl:Ontology, voaf:Vocabulary ;

    # Basic Metadata
    dcterms:title                 "Tool Catalog Ontology (TCAT)"@en ;
    dcterms:description           "An ontology for describing metadata about software tools and services in catalogs or toolboxes, supporting discovery, comparison, and interoperability."@en ;

    # Version Information
    owl:versionInfo               "0.3.0"^^xsd:string ;
    dcterms:hasVersion            "0.3.0"^^xsd:string ;
    owl:versionIRI                <https://w3id.org/dataspaces/ont/tcat/0.3.0> ;
    #owl:priorVersion              <https://w3id.org/dataspaces/ont/tcat/0.0.0> ;

    # Timeline
    dcterms:created               "2025-08-25"^^xsd:date ;
    dcterms:modified              "2026-02-18"^^xsd:date ;
    #dcterms:issued                "<to be added>"^^xsd:date ;
    #bibo:doi                      "<to be added>" ;

    # Creators and Contributors
    dcterms:creator               <https://orcid.org/0000-0003-2885-7076> ;
    #dcterms:creator               <to be added> ;
    #dcterms:contributor           <to be added> ;

    # Publisher Information
    #dcterms:publisher              "<to be added>" ;

    # License and Rights
    dcterms:license               <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights                "This ontology is distributed under the Creative Commons Attribution 4.0 International License."@en ;

    # Namespace Information
    vann:preferredNamespacePrefix "tcat" ;
    vann:preferredNamespaceUri    "https://w3id.org/dataspaces/ont/tcat/"^^xsd:anyURI ;

    # See Also
    rdfs:seeAlso                  <https://github.com/Fraunhofer-FIT-DSAI/ds-tcat-ap> ;
    vann:example                  <https://github.com/Fraunhofer-FIT-DSAI/ds-tcat-ap/tree/main/examples> ;

    # Additional Metadata
    dcterms:language              lang:ENG ;
    dcterms:subject               "Software tool catalog"@en, "Software toolbox"@en, "Software tool metadata"@en ;
    dcterms:audience              "Software toolbox maintainers"@en, "Software tool providers"@en,
                                  "Software tool consumers"@en ;
    dcterms:coverage              "Global"@en .

tcat:SoftwareToolCatalog
    a                owl:Class, rdfs:Class ;
    rdfs:label       "Software Tool Catalog"@en ;
    rdfs:comment     "A catalog of software tools in the generic Tool Catalog Ontology (TCAT)."@en ;
    rdfs:subClassOf  dcat:Catalog, schema:DataCatalog ;
    rdfs:isDefinedBy tcat: .

tcat:SoftwareTool
    a                owl:Class, rdfs:Class ;
    rdfs:label       "Software Tool"@en ;
    rdfs:comment     "A software tool (e.g., application or service) described in a generic tool catalog."@en ;
    rdfs:subClassOf  dcat:Resource, schema:SoftwareApplication ;
    rdfs:isDefinedBy tcat: .

tcat:softwareTool
    a                owl:ObjectProperty, rdf:Property ;
    rdfs:label       "software tool"@en ;
    rdfs:comment     "Links a software tool catalog to a software tool it contains."@en ;
    rdfs:domain      tcat:SoftwareToolCatalog ;
    rdfs:range       tcat:SoftwareTool ;
    rdfs:isDefinedBy tcat: .

tcat:Organization
    a                   owl:Class, rdfs:Class ;
    rdfs:label          "Organization"@en ;
    dcterms:alternative "Institute"@en, "Company"@en ;
    rdfs:comment        "Organization in the Tool Catalog Ontology (TCAT); generic (not dataspace-specific). Aligns with Schema.org, FOAF, and vCard."@en ;
    rdfs:subClassOf     schema:Organization, foaf:Organization, vcard:Organization ;
    rdfs:isDefinedBy    tcat: .

tcat:Person
    a                owl:Class, rdfs:Class ;
    rdfs:label       "Person"@en ;
    rdfs:comment     "Person in the Tool Catalog Ontology (TCAT); aligns with Schema.org, FOAF, and vCard."@en ;
    rdfs:subClassOf  schema:Person, foaf:Person, vcard:Individual ;
    rdfs:isDefinedBy tcat: .

tcat:SoftwareDeployment
    a                owl:Class, rdfs:Class ;
    rdfs:label       "Software Deployment"@en ;
    rdfs:comment     "A description of an existing deployment of a software tool."@en ;
    rdfs:subClassOf  schema:CreativeWork ;
    rdfs:isDefinedBy tcat: .

tcat:applicationDomain
    a                owl:DatatypeProperty, rdf:Property ;
    rdfs:label       "application domain"@en ;
    rdfs:comment     "Application domain of the tool or deployment; use controlled vocabularies (e.g., EuroVoc) where available."@en ;
    rdfs:range       xsd:anyURI ;
    rdfs:isDefinedBy tcat: .

tcat:hasTRL
    a                owl:DatatypeProperty, rdf:Property ;
    rdfs:label       "has TRL"@en ;
    rdfs:comment     "Technology Readiness Level of a software tool; use URIs from a TRL vocabulary."@en ;
    rdfs:domain      tcat:SoftwareTool ;
    rdfs:range       xsd:anyURI ;
    rdfs:isDefinedBy tcat: .

tcat:TRLJustification
    a                owl:DatatypeProperty, rdf:Property ;
    rdfs:label       "TRL justification"@en ;
    rdfs:comment     "Justification for the assigned Technology Readiness Level (TRL)."@en ;
    rdfs:domain      tcat:SoftwareTool ;
    rdfs:range       xsd:string ;
    rdfs:isDefinedBy tcat: .

tcat:softwareDeployment
    a                owl:ObjectProperty, rdf:Property ;
    rdfs:label       "software deployment"@en ;
    rdfs:comment     "Links a software tool to an instance deployment (e.g., where and by whom it is used)."@en ;
    rdfs:domain      tcat:SoftwareTool ;
    rdfs:range       tcat:SoftwareDeployment ;
    rdfs:isDefinedBy tcat: .

tcat:SaaSBusinessOffering
    a                  owl:ObjectProperty, rdf:Property ;
    rdfs:label         "SaaS business offering"@en ;
    rdfs:comment       "Specialized deployment link indicating a deployment offered as SaaS to consumers."@en ;
    rdfs:subPropertyOf tcat:softwareDeployment ;
    rdfs:domain        tcat:SoftwareTool ;
    rdfs:range         tcat:SoftwareDeployment ;
    rdfs:isDefinedBy   tcat: .

tcat:similarTo
    a                  owl:ObjectProperty, rdf:Property ;
    rdfs:label         "similar to"@en ;
    rdfs:comment       "Links a software tool to another tool with similar functionality; subproperty of dcterms:relation."@en ;
    rdfs:subPropertyOf dcterms:relation ;
    rdfs:domain        tcat:SoftwareTool ;
    rdfs:range         tcat:SoftwareTool ;
    rdfs:isDefinedBy   tcat: .

#########################################################################
### Reused terms (minimal mentions with origin via rdfs:isDefinedBy) ###
#########################################################################

